{
  "name": "monitron",
  "version": "0.1.4",
  "private": true,
  "description": "Hardware monitor control for LG and DDC/CI displays",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-volume.ps1",
    "start": "electron .",
    "build:mac": "make -C vendor/m1ddc && swiftc -O -o scripts/mac-media-keys scripts/mac-media-keys.swift",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:installer": "electron-builder --win nsis --x64",
    "dist:win:all": "electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build:mac && electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "local.monitron.app",
    "productName": "Monitron",
    "asar": false,
    "files": [
      "src/**/*",
      "scripts/**/*",
      "vendor/m1ddc/m1ddc",
      "vendor/m1ddc/LICENSE",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "src/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "src/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
